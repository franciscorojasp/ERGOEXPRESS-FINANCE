# ERGOEXPRESS FINANCE - Variables de Entorno
# Copia este archivo como .env y configura los valores apropiados

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
NODE_ENV=development
PORT=3001

# ===========================================
# SUPABASE (NUEVO - RECOMENDADO)
# ===========================================
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_de_supabase
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_de_supabase

# ===========================================
# POSTGRESQL DIRECTO (OPCIONAL - si no usas Supabase)
# ===========================================
# DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# ===========================================
# AUTENTICACIÓN JWT
# ===========================================
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui_min_32_caracteres

# ===========================================
# REDIS (OPCIONAL - PARA CACHE DE SESIONES)
# ===========================================
REDIS_URL=redis://username:password@hostname:port

# ===========================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_FROM=noreply@ergoexpress-finance.com

# ===========================================
# INTEGRACIONES EXTERNAS
# ===========================================

# Groq AI (para inteligencia artificial)
GROQ_API_KEY=tu_groq_api_key

# Stripe (para pagos - opcional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Sheets API (para migración)
GOOGLE_SHEETS_API_KEY=tu_google_sheets_api_key
GOOGLE_SHEETS_SPREADSHEET_ID=tu_spreadsheet_id

# ===========================================
# CONFIGURACIÓN DE SEGURIDAD
# ===========================================
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=28800

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://ergoexpress-finance.vercel.app

# ===========================================
# CONFIGURACIÓN DE BACKUPS
# ===========================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ===========================================
# CONFIGURACIÓN DE REPORTES
# ===========================================
REPORT_RETENTION_MONTHS=12
REPORT_CACHE_TTL=3600